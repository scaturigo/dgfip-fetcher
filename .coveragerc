[run]
# Indique à coverage de chercher le code dans le dossier src
source = dgfip_fetcher
# Active la couverture de branches (vérifie que les deux côtés d'un IF sont testés)
branch = True
# Liste des fichiers à ignorer
omit =
    tests/*
    setup.py

[report]
# Affiche les numéros de lignes manquantes dans le terminal
show_missing = True
# Précision des pourcentages
precision = 2
# Lignes à ignorer lors du calcul de la couverture
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    if __name__ == .__main__.:
    raise AssertionError
    raise NotImplementedError
    if 0:
    if False:

[html]
# Dossier où sera généré le rapport HTML (si vous tapez coverage html)
directory = htmlcov
